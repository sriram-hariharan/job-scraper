POSTGRES_DB=job_scraper_ops
POSTGRES_USER=job_scraper
POSTGRES_PASSWORD=replace_with_strong_password

# Secret key ring for encrypting authenticated users' provider credentials.
# Install a real Fernet-compatible key into the uncommitted .env.production
# with: python3 deploy/install_fernet_key.py --env-file .env.production --apply
APPLYLENS_AI_CREDENTIAL_FERNET_KEYS=replace_with_generated_fernet_key

JOB_STACK_AUTH_ENABLED=true
JOB_STACK_AUTH_COOKIE_SECURE=false
JOB_STACK_AUTH_COOKIE_SAMESITE=lax
JOB_STACK_AUTH_REGISTRATION_ENABLED=false
JOB_STACK_AUTH_FIRST_USER_ADMIN_ENABLED=true
JOB_STACK_AUTH_REGISTRATION_APPROVAL_REQUIRED=true
JOB_STACK_AUTH_APPROVAL_EMAIL_MODE=outbox_only
JOB_STACK_AUTH_APPROVAL_ADMIN_EMAILS=sriramneel97@gmail.com
JOB_STACK_AUTH_APPROVAL_EMAIL_FROM=noreply@applylensjobs.com
JOB_STACK_AUTH_APPROVAL_EMAIL_REPLY_TO=sriramneel97@gmail.com
JOB_STACK_PUBLIC_BASE_URL=https://applylensjobs.com
