[Unit]
Description=ApplyLens global acquisition pipeline
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/apps/job-scraper
ExecStart=/usr/bin/docker compose --env-file .env.production -f docker-compose.prod.yml exec -T web python -u -m src.pipeline.scheduler --job live_pipeline --global-acquisition-only --skip-application-planning --delete-seen-data no --history-path data/scheduler_run_history.jsonl --sync-postgres-run-history --require-postgres-run-history-sync
TimeoutStartSec=5h

[Install]
WantedBy=multi-user.target
